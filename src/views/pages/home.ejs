<%- include('../partials/header') %>
<%- include('../partials/menu') %>
  <div class="container">
    <!-- <button id="authButton" type="submit"> Go </button> -->
    <div class="search-wrapper">
      <h1 id="message"><strong>Great Day Ahead</strong></h1>
      <link rel="icon" href="../resources/img/search-icon.jpg" type="image/jpeg">
      <form action="https://google.com/search" method="get" target="_blank">
        <input type="text" name="q" class="search" id="search" placeholder="Search Google or type a URL">
      </form>  
    </div>
    <div class="spotify" id="recommendations" onload="getRecommendations()">
      <iframe 
        title="Spotify Embed: Recommendation Playlist "
        src="https://open.spotify.com/embed/playlist/4h0HNF4wZa59M5Z4NUGMNK?utm_source=generator&theme=0"
        width="100%"
        height="100%"
        style="min-height: 360px; border-radius: 10px;"
        frameBorder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </div>
  </div>

